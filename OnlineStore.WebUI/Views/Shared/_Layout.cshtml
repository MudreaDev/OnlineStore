@using OnlineStore.Domain.Singleton
@using Microsoft.AspNetCore.Http
@using OnlineStore.WebUI.Extensions
@using OnlineStore.Domain.Entities
@using OnlineStore.Application.Repositories
@inject IHttpContextAccessor HttpContextAccessor
@inject DbUserRepository UserRepo
@inject OnlineStore.Application.Services.CurrencyService CurrencyService
@inject OnlineStore.Application.Services.ToastService ToastService

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ApplicationConfigurationManager.Instance.StoreName</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --bg-base: #f9f7f2; /* Warm Beige */
            --surface: #ffffff;
            --accent-primary: #2d2926; /* Charcoal */
            --accent-secondary: #4a443f;
            --midnight: #2d2926;
            --text-main: #2d2926;
            --text-muted: #8c867e;
            --border-subtle: #eeebe6;
            --border-bold: #d6d2cc;
            --navbar-height: 70px;
            --font-display: 'Outfit', sans-serif;
            --font-body: 'Inter', sans-serif;
            --font-elegant: 'DM Serif Display', serif;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 12px -2px rgb(0 0 0 / 0.08);
            --shadow-lg: 0 12px 24px -4px rgb(0 0 0 / 0.12);
            --transition-smooth: 0.4s cubic-bezier(0.25, 1, 0.5, 1);
            --bg-glass-header: rgba(249, 247, 242, 0.9);
            --bg-glass-input: rgba(255, 255, 255, 0.9);
        }

        :root.dark-theme {
            --bg-base: #121212;
            --surface: #1e1e1e;
            --accent-primary: #e5e5e5;
            --accent-secondary: #b3b3b3;
            --midnight: #f9f9f9;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-subtle: #333333;
            --border-bold: #4b5563;
            --bg-glass-header: rgba(18, 18, 18, 0.9);
            --bg-glass-input: rgba(30, 30, 30, 0.9);
        }

        /* --- Side Cart Drawer --- */
        .cart-drawer-wrapper {
            position: fixed;
            top: 0;
            right: -450px;
            width: 400px;
            max-width: 100vw;
            height: 100vh;
            background: var(--bg-base);
            box-shadow: var(--shadow-lg);
            z-index: 2000;
            transition: right 0.4s cubic-bezier(0.25, 1, 0.5, 1);
            display: flex;
            flex-direction: column;
        }

        body.cart-open .cart-drawer-wrapper { right: 0; }
        body.cart-open .drawer-overlay { display: block; z-index: 1999;}

        @@keyframes fadeInUp {

            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeInUp 0.6s ease-out forwards;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            background-image: 
                radial-gradient(at 0% 0%, rgba(5, 150, 105, 0.03) 0, transparent 50%), 
                radial-gradient(at 50% 0%, rgba(6, 78, 59, 0.02) 0, transparent 50%),
                radial-gradient(at 100% 0%, rgba(5, 150, 105, 0.03) 0, transparent 50%);
            background-attachment: fixed;
            color: var(--text-main);
            font-family: var(--font-body);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
            font-size: 0.9375rem;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* --- Header: Glassmorphism --- */
        .site-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--navbar-height);
            background: var(--bg-glass-header);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            z-index: 1000;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border-subtle);
            transition: var(--transition-smooth);
        }

        .navbar {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 3rem;
            width: 100%;
        }

        /* --- Footer --- */
        .site-footer {
            background: var(--surface);
            border-top: 1px solid var(--border-subtle);
            padding: 5rem 0 3rem;
            margin-top: 6rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1fr;
            gap: 4rem;
            margin-bottom: 4rem;
        }

        .footer-brand .footer-logo {
            font-family: var(--font-elegant);
            font-size: 2rem;
            color: var(--midnight);
            text-decoration: none;
            display: block;
            margin-bottom: 1.5rem;
        }

        .footer-tagline {
            color: var(--text-muted);
            font-size: 0.9375rem;
            max-width: 300px;
            margin-bottom: 2rem;
        }

        .social-links {
            display: flex;
            gap: 1.25rem;
        }

        .social-icon {
            color: var(--text-muted);
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--bg-base);
        }

        .social-icon:hover {
            color: var(--accent-primary);
            background: var(--border-subtle);
            transform: translateY(-3px);
        }

        .footer-heading {
            font-family: var(--font-display);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--midnight);
            margin-bottom: 2rem;
            font-weight: 700;
        }

        .footer-links-list {
            list-style: none;
            padding: 0;
        }

        .footer-links-list li {
            margin-bottom: 1rem;
        }

        .footer-links-list a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9375rem;
            transition: var(--transition-smooth);
        }

        .footer-links-list a:hover {
            color: var(--accent-primary);
            padding-left: 4px;
        }

        .footer-bottom {
            border-top: 1px solid var(--border-subtle);
            padding-top: 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8125rem;
            color: var(--text-muted);
        }

        .payment-methods {
            display: flex;
            gap: 1.5rem;
            opacity: 0.6;
        }

        .payment-badge {
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        @@media (max-width: 1024px) {
            .footer-grid {
                grid-template-columns: 1fr 1fr;
                gap: 3rem;
            }
        }

        @@media (max-width: 640px) {
            .footer-grid {
                grid-template-columns: 1fr;
            }
            .footer-bottom {
                flex-direction: column;
                gap: 1.5rem;
                text-align: center;
            }
        }

        .logo {
            font-family: var(--font-elegant);
            font-size: 1.25rem;
            color: var(--midnight);
            text-decoration: none;
            display: flex;
            align-items: center;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* Search & Filters: Refined Glow */
        .nav-search-form {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            max-width: 700px;
            width: 100%;
            margin: 0 auto;
        }

        .search-input-wrap {
            position: relative;
            flex: 1;
        }

        .nav-search-input {
            width: 100%;
            background: var(--bg-glass-input);
            border: 1px solid var(--border-bold);
            border-radius: 12px;
            padding: 0.5rem 1rem 0.5rem 2.75rem;
            font-size: 0.8125rem;
            font-family: var(--font-body);
            transition: var(--transition-smooth);
        }

        .nav-search-input:focus {
            outline: none;
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.08);
            background: var(--surface);
        }

        .search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        .nav-select {
            background: var(--bg-glass-input);
            border: 1px solid var(--border-bold);
            border-radius: 12px;
            padding: 0.625rem 1rem;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            min-width: 130px;
            transition: var(--transition-smooth);
        }

        .nav-select:hover {
            border-color: var(--accent-primary);
        }

        .btn-filter-toggle {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--surface);
            border: 1px solid var(--border-bold);
            border-radius: 12px;
            padding: 0.5rem 1rem;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            transition: var(--transition-smooth);
            white-space: nowrap;
        }

        .btn-filter-toggle:hover {
            border-color: var(--accent-primary);
            background: var(--bg-base);
        }

        .btn-filter-toggle svg {
            color: var(--text-muted);
        }

        /* Right Side Nav */
        .nav-right {
            display: flex;
            align-items: center;
            gap: 1.75rem;
        }

        .nav-links-desktop {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-main);
            padding: 0.5rem;
            transition: var(--transition-smooth);
        }

        .menu-toggle:hover {
            color: var(--accent-primary);
        }

        .nav-link {
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-main);
            text-decoration: none;
            transition: var(--transition-smooth);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .nav-link:hover {
            color: var(--accent-primary);
        }

        .cart-pill {
            background: var(--midnight);
            color: #fff;
            padding: 0.5rem 1.125rem;
            border-radius: 99px;
            display: flex;
            align-items: center;
            gap: 0.625rem;
            font-size: 0.8125rem;
            font-weight: 700;
            text-decoration: none;
            transition: var(--transition-smooth);
            box-shadow: var(--shadow-sm);
        }

        .cart-pill:hover {
            background: var(--accent-primary);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .wish-pill {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--bg-glass-input);
            border: 1px solid var(--border-bold);
            color: var(--midnight);
            text-decoration: none;
            transition: var(--transition-smooth);
            position: relative;
        }

        .wish-pill:hover {
            border-color: #ef4444;
            color: #ef4444;
            transform: translateY(-1px);
            background: rgba(239, 68, 68, 0.05);
        }

        .wish-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ef4444;
            color: #fff;
            font-size: 0.65rem;
            font-weight: 800;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        /* Wishlist Heart Icon Animation */
        .heart-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 5px;
            color: #ef4444;
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .heart-btn:hover { transform: scale(1.2); }
        .heart-btn:active { transform: scale(0.9); }
        .heart-btn svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.2;
            transition: fill 0.3s ease;
        }
        .heart-btn.is-active svg {
            fill: #ef4444;
        }

        .user-trigger {
            font-weight: 700;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 50%;
            background: var(--border-subtle);
            width: 32px;
            height: 32px;
            justify-content: center;
            transition: var(--transition-smooth);
        }

        .user-trigger:hover {
            background: var(--border-bold);
        }

        .user-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            background: var(--surface);
            border: 1px solid var(--border-bold);
            border-radius: 14px;
            box-shadow: var(--shadow-lg);
            width: 180px;
            padding: 0.5rem;
            margin-top: 0.75rem;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: var(--transition-smooth);
        }

        .user-menu:hover .user-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-item {
            padding: 0.625rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            border-radius: 8px;
            display: block;
            color: var(--text-main);
            text-decoration: none;
            transition: var(--transition-smooth);
        }

        .dropdown-item:hover {
            background: var(--border-subtle);
            color: var(--accent-primary);
        }

        /* --- Alerts --- */
        .alerts-container {
            position: fixed;
            top: 80px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1500;
            width: 100%;
            max-width: 420px;
        }

        .alert {
            padding: 1rem 1.5rem;
            font-size: 0.875rem;
            font-weight: 500;
            border-radius: 14px;
            margin-bottom: 0.75rem;
            box-shadow: var(--shadow-lg);
            backdrop-filter: blur(8px);
            animation: fadeInUp 0.4s ease-out;
        }

        .alert-success {
            background: rgba(236, 253, 245, 0.9);
            color: #065f46;
            border: 1px solid #a7f3d0;
        }

        .alert-danger {
            background: rgba(254, 242, 242, 0.9);
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        /* --- Toasts --- */
        #toast-container {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .toast {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-left: 4px solid var(--accent-primary);
            padding: 1rem 1.5rem;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.06), inset 0 1px 0 rgba(255,255,255,0.6);
            display: flex;
            align-items: center;
            gap: 1rem;
            min-width: 320px;
            animation: slideInRight 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transition: opacity 0.4s, transform 0.4s;
            color: var(--midnight);
        }

        .dark-theme .toast {
            background: rgba(20, 20, 20, 0.8);
            border-color: rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 40px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.1);
            color: #ffffff;
        }

        .toast-success { border-left-color: #10b981; }
        .toast-error { border-left-color: #ef4444; }
        .toast-info { border-left-color: #3b82f6; }

        @@keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* --- Layout --- */
        .main-content {
            padding-top: calc(var(--navbar-height) + 2rem);
            min-height: 70vh;
        }

        .drawer {
            position: fixed;
            top: 0;
            right: -300px;
            width: 280px;
            height: 100vh;
            background: var(--surface);
            z-index: 2000;
            padding: 2rem;
            transition: right 0.3s ease;
        }

        .drawer-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            z-index: 1999;
        }

        body.menu-open .drawer {
            right: 0;
        }

        body.menu-open .drawer-overlay {
            display: block;
        }

        @@media (max-width: 1024px) {
            .nav-search-form {
                max-width: 400px;
            }

            .navbar {
                gap: 1rem;
            }
        }

        @@media (max-width: 768px) {

            .nav-search-form,
            .nav-links-desktop {
                display: none;
            }

            .menu-toggle {
                display: block;
            }
        }
    </style>
    <script>
        // Prevent theme flash by reading local storage immediately
        (function () {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark-theme');
            } else {
                document.documentElement.classList.remove('dark-theme');
            }
        })();
    </script>
</head>

<body>
    <header class="site-header" id="header">
        <div class="container navbar">
            <a class="logo" asp-controller="Home" asp-action="Index">
                @ApplicationConfigurationManager.Instance.StoreName
            </a>

            <form id="liveFilterForm" method="get" asp-controller="Home" asp-action="Index" asp-fragment="collection" class="nav-search-form">
                <div class="search-input-wrap">
                    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" name="searchQuery" id="navSearchInput"
                        value="@Context.Request.Query["searchQuery"]" placeholder="Caută în colecție..."
                        class="nav-search-input" autocomplete="off" />
                </div>
                
                <button type="button" class="btn-filter-toggle" onclick="toggleSidebar()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="4" y1="21" x2="4" y2="14"></line>
                        <line x1="4" y1="10" x2="4" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12" y2="3"></line>
                        <line x1="20" y1="21" x2="20" y2="16"></line>
                        <line x1="20" y1="12" x2="20" y2="3"></line>
                        <line x1="1" y1="14" x2="7" y2="14"></line>
                        <line x1="9" y1="8" x2="15" y2="8"></line>
                        <line x1="17" y1="16" x2="23" y2="16"></line>
                    </svg>
                    Filtre
                </button>

                @* Hidden fields for other filters to preserve state during search *@
                @if (Context.Request.Query.ContainsKey("categoryFilter")) { <input type="hidden" name="categoryFilter" value="@Context.Request.Query["categoryFilter"]" /> }
                @if (Context.Request.Query.ContainsKey("minPrice")) { <input type="hidden" name="minPrice" value="@Context.Request.Query["minPrice"]" /> }
                @if (Context.Request.Query.ContainsKey("maxPrice")) { <input type="hidden" name="maxPrice" value="@Context.Request.Query["maxPrice"]" /> }
                @if (Context.Request.Query.ContainsKey("sortStrategy")) { <input type="hidden" name="sortStrategy" value="@Context.Request.Query["sortStrategy"]" /> }
                @foreach (var val in Context.Request.Query["selectedSizes"]) { <input type="hidden" name="selectedSizes" value="@val" /> }
                @foreach (var val in Context.Request.Query["selectedColors"]) { <input type="hidden" name="selectedColors" value="@val" /> }
                @foreach (var val in Context.Request.Query["selectedFuelTypes"]) { <input type="hidden" name="selectedFuelTypes" value="@val" /> }
                @if (Context.Request.Query.ContainsKey("minYear")) { <input type="hidden" name="minYear" value="@Context.Request.Query["minYear"]" /> }
                @if (Context.Request.Query.ContainsKey("maxYear")) { <input type="hidden" name="maxYear" value="@Context.Request.Query["maxYear"]" /> }
            </form>
 
             <div class="nav-right">
                 <nav class="nav-links-desktop">
                     <a class="nav-link" asp-controller="Home" asp-action="Index">Magazin</a>
                     <a class="nav-link" asp-controller="Home" asp-action="OutOfStock" style="color: #ef4444; font-weight: 800;">Arhivă</a>
 
                     @{
                         var session = Context.Session;
                         var cart = session.Get<ShoppingCart>("Cart");
                         var count = cart?.Items.Sum(i => i.Quantity) ?? 0;
                         var username = session.GetString("Username");
                         
                         var wishlist = session.Get<List<Guid>>("Wishlist") ?? new List<Guid>();
                         var wishCount = wishlist.Count;
                     }
                     <a class="wish-pill" asp-controller="Wishlist" asp-action="Index" style="margin-right: -0.5rem;">
                         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                             <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                         </svg>
                         <span id="wishlist-badge" class="wish-badge" style="display: @(wishCount > 0 ? "flex" : "none")">@wishCount</span>
                     </a>
 
                     <button id="themeToggle" class="wish-pill" style="margin-right: -0.5rem;" aria-label="Toggle Theme">
                         <!-- Sun Icon (visible in dark theme) -->
                         <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display: none;">
                             <circle cx="12" cy="12" r="5"></circle>
                             <line x1="12" y1="1" x2="12" y2="3"></line>
                             <line x1="12" y1="21" x2="12" y2="23"></line>
                             <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                             <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                             <line x1="1" y1="12" x2="3" y2="12"></line>
                             <line x1="21" y1="12" x2="23" y2="12"></line>
                             <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                             <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                         </svg>
                         <!-- Moon Icon (visible in light theme) -->
                         <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                             <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                         </svg>
                     </button>
 
                     <a class="cart-pill" href="javascript:void(0)" onclick="openCart()">
                         <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5">
                             <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4H6z"></path>
                             <line x1="3" y1="6" x2="21" y2="6"></line>
                             <path d="M16 10a4 4 0 0 1-8 0"></path>
                         </svg>
                         <span>Coș @(count > 0 ? " • " + count : "")</span>
                     </a>
 
 
                     @if (!string.IsNullOrEmpty(username))
                     {
                         <div class="user-menu" style="position: relative;">
                             <div class="user-trigger">
                                 @username.Substring(0, 1).ToUpper()
                                 <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="3">
                                     <path d="M6 9l6 6 6-6"></path>
                                 </svg>
                             </div>
                             <div class="user-dropdown">
                                 <a class="dropdown-item" asp-controller="Profile" asp-action="Index">Profil</a>
                                 @{
                                     var userIdStr = session.GetString("UserId");
                                     if (!string.IsNullOrEmpty(userIdStr) && Guid.TryParse(userIdStr, out Guid userId))
                                     {
                                         var user = UserRepo.GetById(userId);
                                         if (user is Admin)
                                         {
                                             <a class="dropdown-item" asp-controller="Admin" asp-action="Index">Dashboard</a>
                                             <a class="dropdown-item" asp-controller="Home" asp-action="Catalog">Catalog Inventar</a>
                                         }
                                         else
                                         {
                                             <a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders">Comenzi</a>
                                         }
                                     }
                                 }
                                 <a class="dropdown-item" style="color: #a4161a" asp-controller="Account"
                                     asp-action="Logout">Deconectare</a>
                             </div>
                         </div>
                     }
                     else
                     {
                         <a class="cart-pill" asp-controller="Account" asp-action="Login" style="background: transparent; border: 1.5px solid var(--midnight); color: var(--midnight);">Autentificare</a>
                     }
                </nav>

                <button class="menu-toggle" onclick="toggleMenu()">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    @* Mobile Drawer remains similar but with smaller fonts *@
    <div class="drawer-overlay" onclick="toggleMenu()"></div>
    <div class="drawer">
        <div class="drawer-header">
            <button class="menu-toggle" onclick="toggleMenu()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div style="margin-bottom: 2rem;">
            <form method="get" asp-controller="Home" asp-action="Index">
                <input type="text" name="searchQuery"
                    style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-light);"
                    placeholder="Caută..." />
            </form>
        </div>
        <nav class="drawer-links">
            <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Home" asp-action="Index">Magazin</a>
            <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Home" asp-action="OutOfStock">Arhivă</a>
            <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Cart" asp-action="Index">Coș (@count)</a>
            <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Wishlist" asp-action="Index">Favorite (@wishCount)</a>
            
            @if (!string.IsNullOrEmpty(username))
            {
                <hr style="border: 0; border-top: 1px solid var(--border-subtle); margin: 1rem 0;" />
                <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Profile" asp-action="Index">Profilul meu</a>
                
                var userIdStr = session.GetString("UserId");
                if (!string.IsNullOrEmpty(userIdStr) && Guid.TryParse(userIdStr, out Guid userId))
                {
                    var user = UserRepo.GetById(userId);
                    if (user is Admin)
                    {
                        <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Admin" asp-action="Index">Dashboard</a>
                        <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Home" asp-action="Catalog">Catalog (Compozit)</a>
                    }
                    else
                    {
                        <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Orders" asp-action="MyOrders">Comenzile mele</a>
                    }
                }
                <a class="drawer-link" style="font-size: 1.125rem; color: #a4161a" asp-controller="Account" asp-action="Logout">Deconectare</a>
            }
            else
            {
                <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Account" asp-action="Login">Autentificare</a>
                <a class="drawer-link" style="font-size: 1.125rem;" asp-controller="Account" asp-action="Register">Înregistrare</a>
            }
        </nav>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["Success"] != null)
            {
                <text>showToast('@TempData["Success"]', 'success');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>showToast('@TempData["Error"]', 'error');</text>
            }
        });
    </script>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

