@model IEnumerable<OnlineStore.Domain.Entities.Product>
@using OnlineStore.Domain.Entities

@{
    ViewData["Title"] = "Inventory Management";
}

<style>
    :root {
        --dash-bg: #f9f7f2;
        --dash-card-bg: #ffffff;
        --dash-card-border: #eeebe6;
        --dash-border: #d6d2cc;
        --dash-accent: #2d2926;
        --dash-accent-glow: rgba(45, 41, 38, 0.05);
        --dash-success: #2b7a5a;
        --dash-success-glow: rgba(43, 122, 90, 0.08);
        --dash-warning: #c28b57;
        --dash-warning-glow: rgba(194, 139, 87, 0.08);
        --dash-danger: #b33939;
        --dash-text-main: #2d2926;
        --dash-text-muted: #8c867e;
    }

    body {
        background-color: var(--dash-bg);
        color: var(--dash-text-main);
        font-family: 'Outfit', 'Inter', sans-serif;
    }

    .admin-wrapper {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--dash-card-border);
    }

    .dash-title-area h1 {
        font-size: 2.25rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin: 0;
        background: linear-gradient(135deg, var(--dash-accent) 40%, var(--dash-text-muted) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .dash-title-area p {
        font-size: 0.875rem;
        color: var(--dash-text-muted);
        margin: 0.25rem 0 0 0;
    }

    .dash-layout {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 2.5rem;
        align-items: start;
    }

    /* Sidebar Design */
    .dash-sidebar {
        position: sticky;
        top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .glass-card {
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-card-border);
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(45, 41, 38, 0.04);
    }

    .sidebar-menu {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .menu-btn {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 0.8rem 1rem;
        border-radius: 10px;
        text-decoration: none;
        color: var(--dash-text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

    .menu-btn svg {
        transition: transform 0.2s ease;
    }

    .menu-btn:hover {
        background: rgba(45, 41, 38, 0.03);
        color: var(--dash-text-main);
    }

    .menu-btn:hover svg {
        transform: translateX(2px);
    }

    .menu-btn.active {
        background: var(--dash-accent);
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(45, 41, 38, 0.15);
    }

    .sidebar-divider {
        height: 1px;
        background: var(--dash-card-border);
        margin: 0.5rem 0;
    }

    .btn-create {
        background: var(--dash-accent);
        color: #fff;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.875rem;
        transition: var(--transition-smooth);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
    }

    .btn-create:hover {
        background: #4a443f;
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    /* --- Refined Table Card --- */
    .inventory-card {
        background: #fff;
        border: 1px solid var(--dash-card-border);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .inventory-table {
        width: 100%;
        border-collapse: collapse;
    }

    .inventory-table thead {
        background: var(--bg-base);
        border-bottom: 1px solid var(--dash-card-border);
    }

    .inventory-table th {
        padding: 0.9rem 1.25rem;
        text-align: left;
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--dash-text-muted);
        letter-spacing: 0.1em;
    }

    .inventory-table td {
        padding: 0.9rem 1.25rem;
        font-size: 0.825rem;
        color: var(--dash-text-main);
        border-bottom: 1px solid var(--dash-card-border);
        vertical-align: middle;
    }

    .inventory-table tr:last-child td {
        border-bottom: none;
    }

    .inventory-table tbody tr:hover {
        background: rgba(45, 41, 38, 0.01);
    }

    .item-name {
        font-weight: 700;
        color: var(--dash-text-main);
        font-family: var(--font-display);
    }

    /* Badges */
    .admin-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.75rem;
        border-radius: 8px;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .badge-electro {
        background: #eff6ff;
        color: #1e40af;
    }

    .badge-clothing {
        background: #fdf4ff;
        color: #7e22ce;
    }

    .badge-vehicle {
        background: #fff7ed;
        color: #c2410c;
    }

    .badge-neutral {
        background: var(--bg-base);
        color: var(--dash-text-muted);
    }

    .stock-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 0.8125rem;
    }

    .stock-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    /* Row Actions */
    .action-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-icon-action {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--dash-card-border);
        background: #fff;
        color: var(--dash-text-muted);
        transition: var(--transition-smooth);
        cursor: pointer;
        text-decoration: none;
    }

    .btn-icon-action:hover {
        border-color: var(--dash-accent);
        color: var(--dash-accent);
        background: var(--dash-accent-glow);
    }

    .btn-delete-row:hover {
        border-color: #fca5a5;
        color: #dc2626;
        background: #fef2f2;
    }

    .pagination-wrap {
        margin-top: 1.5rem;
        display: flex;
        justify-content: center;
        gap: 0.5rem;
    }

    .admin-page-link {
        padding: 0.6rem 1rem;
        border-radius: 10px;
        border: 1px solid var(--dash-card-border);
        color: var(--dash-text-main);
        font-weight: 700;
        text-decoration: none;
        transition: var(--transition-smooth);
        font-size: 0.8125rem;
    }

    .admin-page-link:hover {
        border-color: var(--dash-accent);
        color: var(--dash-accent);
    }

    .admin-page-link.active {
        background: var(--dash-accent);
        color: #fff;
        border-color: var(--dash-accent);
    }
</style>

<div class="admin-wrapper fade-in">
    <!-- Header -->
    <div class="dash-header">
        <div class="dash-title-area">
            <h1>Stoc <span style="color:var(--dash-accent)">Produse</span></h1>
            <p>Panou de Gestiune · Administrare inventar magazin de modă</p>
        </div>
        <a asp-action="AddProduct" class="btn-create">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Adaugă Produs Nou
        </a>
    </div>

    <!-- Main Layout Grid with Sidebar -->
    <div class="dash-layout">
        <!-- Sidebar Navigation -->
        <div class="dash-sidebar">
            <div class="glass-card sidebar-menu">
                <a asp-action="Index" class="menu-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                        <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                        <rect x="3" y="16" width="7" height="5" rx="1"></rect>
                    </svg>
                    Panou Principal
                </a>
                <a asp-action="Products" class="menu-btn active">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                    </svg>
                    Stoc Produse
                </a>
                <a asp-action="Orders" class="menu-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    Comenzi Flux
                </a>
                <a asp-action="SalesStatistics" class="menu-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                    Statistici Vânzări
                </a>
                <div class="sidebar-divider"></div>
                <a href="@Url.Action("Index", "Admin")#visual" class="menu-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    Categorii Vizuale
                </a>
                <a href="@Url.Action("Index", "Admin")#config" class="menu-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                    Setări Magazin
                </a>
            </div>
        </div>

        <!-- Right Side: Content Area -->
        <div style="display: flex; flex-direction: column;">

    <div class="inventory-card">
        @if (!Model.Any())
        {
            <div style="text-align: center; padding: 6rem 2rem;">
                <div style="font-size: 3rem; margin-bottom: 1.5rem; opacity: 0.3;">🗃️</div>
                <h4 style="font-family: var(--font-display); color: var(--midnight);">No inventory items</h4>
                <p style="color: var(--text-muted); font-size: 0.875rem;">Your digital warehouse is currently empty.</p>
            </div>
        }
        else
        {
            <table class="inventory-table">
                <thead>
                    <tr>
                        <th>Product Details</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Shipment Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                <div class="item-name">@product.Name</div>
                                <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 0.25rem;">
                                    @if (product is AccessoryProduct accessory)
                                    {
                                        <span>Material: @accessory.Material</span>
                                    }
                                    else if (product is ClothingProduct clothing)
                                    {
                                        <span>Sizes: @clothing.AvailableSizes | @clothing.Material</span>
                                    }
                                    else if (product is FootwearProduct footwear)
                                    {
                                        <span>Sizes: @footwear.AvailableSizes | @footwear.Material</span>
                                    }
                                    else
                                    {
                                        <span>ID: @product.Id.ToString().Substring(0, 8)</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @{
                                    var typeName = product.GetType().Name.Replace("Product", "");
                                    var badgeClass = typeName switch
                                    {
                                        "Accessory" => "badge-electro",
                                        "Clothing" => "badge-clothing",
                                        "Footwear" => "badge-vehicle",
                                        _ => "badge-neutral"
                                    };
                                }
                                <span class="admin-badge @badgeClass">@typeName</span>
                            </td>
                            <td style="font-weight: 700; color: var(--midnight);">@product.Price.ToString("C0")</td>
                            <td>
                                <div class="stock-indicator"
                                    style="color: @(product.Stock > 0 ? "var(--accent-primary)" : "#dc2626")">
                                    <div class="stock-dot"
                                        style="background: @(product.Stock > 0 ? "var(--accent-primary)" : "#dc2626")"></div>
                                    @product.Stock units
                                </div>
                            </td>
                            <td>
                                <div class="action-group">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn-icon-action" title="Edit">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                            stroke-width="2.5">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </a>
                                    <form asp-action="CloneProduct" asp-route-id="@product.Id" method="post">
                                        <button type="submit" class="btn-icon-action" title="Clone">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2.5">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                            </svg>
                                        </button>
                                    </form>
                                    <form asp-action="DeleteProduct" asp-route-id="@product.Id" method="post"
                                        onsubmit="return confirm('Archive \'@product.Name\'?')">
                                        <button type="submit" class="btn-icon-action btn-delete-row" title="Delete">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2.5">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path
                                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                </path>
                                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                                <line x1="14" y1="11" x2="14" y2="17"></line>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination-wrap">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Products" asp-route-page="@i"
                    class="admin-page-link @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
            }
        </div>
    }
        </div>
    </div>
</div>
