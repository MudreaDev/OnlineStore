@model OnlineStore.WebUI.Models.RegisterViewModel

@{
    ViewData["Title"] = "Înregistrare";
}

<style>
    .auth-container-fullscreen {
        margin: -2rem auto -4rem; /* Compensate for layout padding */
        min-height: calc(100vh - var(--navbar-height));
        display: grid;
        grid-template-columns: 1fr 1fr;
        background-color: var(--bg-base);
    }

    /* Left Side - Luxury Visual Panel */
    .auth-visual-panel {
        position: relative;
        background-image: url('/images/auth_background.png');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: flex-end;
        padding: 4rem;
        color: #ffffff;
        overflow: hidden;
    }

    .auth-visual-panel::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(45, 41, 38, 0.15) 0%, rgba(45, 41, 38, 0.85) 100%);
        z-index: 1;
    }

    .auth-visual-content {
        position: relative;
        z-index: 2;
        max-width: 520px;
        animation: fadeInUp 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .auth-tagline-badge {
        display: inline-block;
        font-family: var(--font-body);
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 0.4rem 1rem;
        border-radius: 99px;
        margin-bottom: 2rem;
        backdrop-filter: blur(4px);
    }

    .auth-visual-title {
        font-family: var(--font-elegant);
        font-size: 3rem;
        line-height: 1.15;
        font-weight: 400;
        letter-spacing: -0.02em;
        margin-bottom: 1.25rem;
        color: #ffffff;
        text-shadow: 0 2px 10px rgba(0,0,0,0.15);
    }

    .auth-visual-text {
        font-family: var(--font-body);
        font-size: 0.95rem;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.75);
    }

    /* Right Side - Form Panel */
    .auth-form-panel {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 3rem 2rem;
        position: relative;
    }

    .auth-glass-card {
        background: rgba(255, 255, 255, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(24px) saturate(120%);
        -webkit-backdrop-filter: blur(24px) saturate(120%);
        border-radius: 32px;
        padding: 3rem;
        width: 100%;
        max-width: 540px;
        box-shadow: 0 30px 70px rgba(45, 41, 38, 0.04), 
                    inset 0 1px 0 rgba(255, 255, 255, 0.8);
        animation: cardAppear 0.6s cubic-bezier(0.25, 1, 0.5, 1);
        position: relative;
        z-index: 2;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .auth-title {
        font-family: var(--font-elegant);
        font-size: 1.85rem;
        color: var(--midnight);
        letter-spacing: -0.02em;
        margin-bottom: 0.4rem;
    }

    .auth-subtitle {
        color: var(--text-muted);
        font-size: 0.875rem;
    }

    .section-headline-custom {
        font-family: var(--font-display);
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--midnight);
        margin-top: 1.5rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .section-headline-custom::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border-subtle);
    }

    .form-grid-custom {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-group-custom {
        margin-bottom: 1rem;
        position: relative;
    }

    .form-group-custom.full-width {
        grid-column: span 2;
    }

    .input-wrapper-custom {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon-left {
        position: absolute;
        left: 1.25rem;
        color: var(--text-muted);
        pointer-events: none;
        transition: var(--transition-smooth);
    }

    .form-control-custom {
        width: 100%;
        background: rgba(255, 255, 255, 0.4);
        border: 1.5px solid var(--border-subtle);
        border-radius: 14px;
        padding: 0.85rem 1.25rem 0.85rem 3rem;
        font-family: var(--font-body);
        font-size: 0.875rem;
        color: var(--midnight);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        outline: none;
    }

    .form-control-custom:focus {
        background: #ffffff;
        border-color: var(--midnight);
        box-shadow: 0 0 0 5px rgba(45, 41, 38, 0.05);
    }

    .form-control-custom:focus + .input-icon-left {
        color: var(--midnight);
    }

    .textarea-custom {
        min-height: 90px;
        resize: vertical;
        padding-left: 1.25rem;
    }

    .password-toggle-btn {
        position: absolute;
        right: 1rem;
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.25rem;
        border-radius: 6px;
        transition: var(--transition-smooth);
    }

    .password-toggle-btn:hover {
        color: var(--midnight);
        background: rgba(45, 41, 38, 0.05);
    }

    .form-label-custom {
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 0.4rem;
        display: block;
        padding-left: 0.25rem;
    }

    .input-error-custom {
        color: #a4161a;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 0.35rem;
        display: block;
        padding-left: 0.25rem;
        animation: fadeInUp 0.3s ease;
    }

    .btn-register-premium {
        width: 100%;
        background: var(--midnight);
        color: #ffffff;
        border: none;
        border-radius: 14px;
        padding: 0.95rem;
        font-size: 0.875rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        margin-top: 1.5rem;
        box-shadow: 0 10px 25px rgba(45, 41, 38, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-register-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(45, 41, 38, 0.25);
        background: #000000;
    }

    .btn-register-premium:active {
        transform: translateY(0);
    }

    .auth-switch-prompt {
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 2rem;
    }

    .auth-switch-link {
        color: var(--midnight);
        font-weight: 700;
        text-decoration: none;
        position: relative;
        padding-bottom: 2px;
    }

    .auth-switch-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1.5px;
        background: var(--midnight);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    .auth-switch-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    .validation-summary-custom {
        margin-bottom: 1.5rem;
        padding: 1rem 1.25rem;
        background: rgba(254, 242, 242, 0.9);
        border: 1px solid #fee2e2;
        border-radius: 14px;
        color: #991b1b;
        font-size: 0.8125rem;
        font-weight: 500;
        text-align: left;
        backdrop-filter: blur(8px);
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardAppear {
        from {
            opacity: 0;
            transform: translateY(15px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Responsive adjustments */
    @@media (max-width: 991px) {
        .auth-container-fullscreen {
            grid-template-columns: 1fr;
            margin: -2rem auto -4rem;
            position: relative;
        }

        .auth-visual-panel {
            display: none;
        }

        .auth-form-panel {
            background-image: url('/images/auth_background.png');
            background-size: cover;
            background-position: center;
            min-height: calc(100vh - var(--navbar-height));
            padding: 3rem 1.5rem;
        }

        .auth-form-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(249, 247, 242, 0.65);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 1;
        }
    }

    @@media (max-width: 580px) {
        .form-grid-custom {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-group-custom {
            grid-column: span 2;
        }

        .auth-glass-card {
            padding: 2.5rem 1.5rem;
        }
    }
</style>

<div class="auth-container-fullscreen">
    <!-- Visual side for wide displays -->
    <div class="auth-visual-panel">
        <div class="auth-visual-content">
            <span class="auth-tagline-badge">Membru de Onoare</span>
            <h1 class="auth-visual-title">Mai puțin înseamnă întotdeauna mai mult.</h1>
            <p class="auth-visual-text">Un cont deschide porțile către selecții de design minimalist, livrare gratuită prioritară și oferte exclusive. Alătură-te comunității noastre de lifestyle.</p>
        </div>
    </div>

    <!-- Interactive Form side -->
    <div class="auth-form-panel">
        <div class="auth-glass-card">
            <div class="auth-header">
                <h2 class="auth-title">Alătură-te colecției</h2>
                <p class="auth-subtitle">Creează-ți un cont pentru a începe curatoria stilului tău.</p>
            </div>

            @if (!ViewContext.ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="validation-summary-custom"></div>
            }

            <form asp-action="Register" method="post" class="auth-form">
                
                <h3 class="section-headline-custom">Detalii Cont</h3>

                <div class="form-grid-custom">
                    <div class="form-group-custom">
                        <label asp-for="Username" class="form-label-custom">Nume utilizator</label>
                        <div class="input-wrapper-custom">
                            <svg class="input-icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <input asp-for="Username" class="form-control-custom" placeholder="Nume utilizator..." />
                        </div>
                        <span asp-validation-for="Username" class="input-error-custom"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="Email" class="form-label-custom">Adresă Email</label>
                        <div class="input-wrapper-custom">
                            <svg class="input-icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <input asp-for="Email" class="form-control-custom" placeholder="nume@exemplu.com" />
                        </div>
                        <span asp-validation-for="Email" class="input-error-custom"></span>
                    </div>
                </div>

                <h3 class="section-headline-custom">Securitate</h3>

                <div class="form-grid-custom">
                    <div class="form-group-custom">
                        <label asp-for="Password" class="form-label-custom">Parolă</label>
                        <div class="input-wrapper-custom">
                            <svg class="input-icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <input asp-for="Password" type="password" class="form-control-custom" placeholder="••••••••" style="padding-right: 3rem;" />
                            <button type="button" class="password-toggle-btn" id="password-toggle" onclick="togglePasswordVisibility('Password', 'password-toggle')" aria-label="Toggle Password Visibility">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="input-error-custom"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="ConfirmPassword" class="form-label-custom">Confirmă Parola</label>
                        <div class="input-wrapper-custom">
                            <svg class="input-icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <input asp-for="ConfirmPassword" type="password" class="form-control-custom" placeholder="••••••••" style="padding-right: 3rem;" />
                            <button type="button" class="password-toggle-btn" id="confirm-password-toggle" onclick="togglePasswordVisibility('ConfirmPassword', 'confirm-password-toggle')" aria-label="Toggle Confirm Password Visibility">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="input-error-custom"></span>
                    </div>
                </div>

                <h3 class="section-headline-custom">Livrare</h3>

                <div class="form-group-custom full-width">
                    <label asp-for="ShippingAddress" class="form-label-custom">Adresă Principală de Livrare</label>
                    <div class="input-wrapper-custom">
                        <textarea asp-for="ShippingAddress" class="form-control-custom textarea-custom" placeholder="Unde dorești să trimitem comenzile tale?"></textarea>
                    </div>
                    <span asp-validation-for="ShippingAddress" class="input-error-custom"></span>
                </div>

                <button type="submit" class="btn-register-premium">
                    Creează Contul
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </form>

            <div class="auth-switch-prompt">
                Ai deja cont? <a asp-action="Login" class="auth-switch-link">Autentifică-te aici</a>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, buttonId) {
        const passwordInput = document.getElementById(inputId);
        const toggleButton = document.getElementById(buttonId);
        if (passwordInput && toggleButton) {
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleButton.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`;
            } else {
                passwordInput.type = 'password';
                toggleButton.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
            }
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
