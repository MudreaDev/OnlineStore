@model OnlineStore.Domain.Entities.Order

@{
    ViewData["Title"] = "Order Details";
}

<style>
    .order-details-page {
        max-width: 800px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .back-link { margin-bottom: 2rem; }
    .btn-back {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.875rem;
        font-weight: 600;
        transition: var(--transition-smooth);
    }
    .btn-back:hover { color: var(--midnight); }

    .details-card {
        background: var(--surface);
        border: 1px solid var(--border-subtle);
        border-radius: 24px;
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        animation: fadeInUp 0.8s ease-out;
    }

    .details-header {
        background: #fcfbf8;
        padding: 2.5rem;
        border-bottom: 1px solid var(--border-subtle);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .order-tag {
        display: block;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .details-header h2 {
        font-family: var(--font-elegant);
        font-size: 1.75rem;
        color: var(--midnight);
    }

    .header-meta { text-align: right; }
    .order-date {
        display: block;
        margin-top: 0.75rem;
        font-size: 0.8125rem;
        color: var(--text-muted);
    }

    .details-body { padding: 2.5rem; }

    .customer-info h3, .order-items h3 {
        font-family: var(--font-display);
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--border-subtle);
        padding-bottom: 0.5rem;
    }

    .customer-info p {
        color: var(--text-main);
        font-size: 0.9375rem;
        line-height: 1.6;
    }

    .item-list { list-style: none; padding: 0; }
    .item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--border-subtle);
    }

    .item-info { display: flex; gap: 1rem; align-items: center; }
    .item-icon { font-size: 1.25rem; opacity: 0.6; }
    .item-name { font-weight: 600; color: var(--midnight); display: block; }
    .item-category { font-size: 0.75rem; color: var(--text-muted); }
    .item-price { font-weight: 700; color: var(--midnight); }

    .order-summary {
        margin-top: 2rem;
        background: var(--bg-base);
        padding: 1.5rem;
        border-radius: 16px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .total-row span:first-child {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--text-muted);
    }

    .grand-total {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--midnight);
    }

    .status-badge {
        display: inline-flex;
        padding: 0.4rem 1rem;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }
    .status-pending { background: #fff7ed; color: #9a3412; }
    .status-shipped { background: #f0f9ff; color: #075985; }
    .status-delivered { background: #f0fdf4; color: #166534; }
    .status-cancelled { background: #fef2f2; color: #991b1b; }
</style>

<div class="order-details-page">
    <div class="back-link">
        <a asp-action="MyOrders" class="btn-back">← Back to My Orders</a>
    </div>

    <div class="details-card">
        <div class="details-header">
            <div class="header-main">
                <span class="order-tag">Order Details</span>
                <h2>#@Model.Id</h2>
            </div>
            <div class="header-meta">
                <span class="status-badge status-@Model.Status.ToString().ToLower()">@Model.Status</span>
                <span class="order-date">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy")</span>
            </div>
        </div>

        <div class="details-body">
            <div class="customer-info">
                <h3>Delivery Address</h3>
                <p>
                    @if (Model.User is OnlineStore.Domain.Entities.Customer customer)
                    {
                        @customer.ShippingAddress
                    }
                    else
                    {
                        <span>No address available</span>
                    }
                </p>
            </div>

            <div class="order-items mt-4">
                <h3>Items in this Order</h3>
                <ul class="item-list">
                    @foreach (var item in Model.Items)
                    {
                        <li class="item-row">
                            <div class="item-info">
                                <span class="item-icon">📦</span>
                                <div class="item-text">
                                    <span class="item-name">@item.ProductName x @item.Quantity</span>
                                    @if (!string.IsNullOrEmpty(item.Size) || !string.IsNullOrEmpty(item.Color))
                                    {
                                        <span class="item-category">
                                            @if (!string.IsNullOrEmpty(item.Size))
                                            {
                                                <span>Size: @item.Size </span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Color))
                                            {
                                                <span>Color: @item.Color</span>
                                            }
                                        </span>
                                    }
                                </div>
                            </div>
                            <span class="item-price">@((item.UnitPrice * item.Quantity).ToString("C"))</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="order-summary mt-4">
                <div class="summary-row total-row">
                    <span>Total Amount Paid</span>
                    <span class="grand-total">@Model.Total.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
</div>
