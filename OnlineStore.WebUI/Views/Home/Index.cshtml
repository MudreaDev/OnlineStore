@model IEnumerable<OnlineStore.Domain.Entities.Product>
@{
    ViewData["Title"] = "Colecție Minimalistă";
    var categoryDisplayNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "All", "Toate Colecțiile" },
        { "Footwear", "Încălțăminte" },
        { "Accessory", "Accesorii" },
        { "Main Collection", "Colecția Principală" },
        { "Clothing", "Îmbrăcăminte" }
    };
}

<style>
    /* --- Premium Hero Section --- */
    .hero-section {
        position: relative;
        height: 65vh;
        min-height: 460px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #ffffff;
        margin: -2rem auto 4rem; /* Extend up slightly to integrate beautifully */
        overflow: hidden;
        background: #111;
        border-bottom-left-radius: 40px;
        border-bottom-right-radius: 40px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background-image: url('https://images.unsplash.com/photo-1524758631624-e2822e304c36?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80');
        background-size: cover;
        background-position: center;
        filter: brightness(0.65) contrast(1.05);
        transition: transform 3s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .hero-section::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(18, 18, 18, 0.2) 0%, rgba(18, 18, 18, 0.6) 100%);
        z-index: 1;
    }

    .hero-section:hover .hero-bg {
        transform: scale(1.03);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 800px;
        padding: 0 2rem;
        animation: fadeInUp 1s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .hero-tag {
        display: inline-block;
        font-family: var(--font-body);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.35);
        padding: 0.45rem 1.25rem;
        border-radius: 99px;
        margin-bottom: 1.75rem;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(8px);
    }

    .hero-title {
        font-family: var(--font-elegant);
        font-size: clamp(2.75rem, 8vw, 4.75rem);
        font-weight: 400;
        margin-bottom: 1rem;
        letter-spacing: -0.02em;
        line-height: 1.1;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .hero-subtitle {
        font-family: var(--font-body);
        font-size: clamp(0.95rem, 2.5vw, 1.15rem);
        font-weight: 400;
        color: rgba(255, 255, 255, 0.85);
        margin-bottom: 2.75rem;
    }

    .hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: #ffffff;
        color: var(--midnight);
        padding: 1.1rem 2.5rem;
        border-radius: 99px;
        text-decoration: none;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.75rem;
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    }

    .hero-cta:hover {
        background: var(--midnight);
        color: #ffffff;
        transform: translateY(-3px);
        box-shadow: 0 20px 45px rgba(0,0,0,0.25);
    }

    /* --- Category Grid (Glassmorphism Tiles) --- */
    .category-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin-bottom: 5rem;
    }

    .category-card {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 28px;
        box-shadow: 0 10px 30px rgba(45, 41, 38, 0.03);
        border: 1px solid var(--border-subtle);
        background: #ffffff;
    }

    .category-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .category-card:hover .category-img {
        transform: scale(1.06);
    }

    .category-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(45, 41, 38, 0) 40%, rgba(45, 41, 38, 0.65) 100%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        padding: 2.5rem;
        color: #ffffff;
        transition: all 0.4s;
    }

    .category-card:hover .category-overlay {
        background: linear-gradient(180deg, rgba(45, 41, 38, 0.1) 20%, rgba(45, 41, 38, 0.75) 100%);
    }

    .category-name {
        font-family: var(--font-elegant);
        font-size: 1.85rem;
        font-weight: 400;
        margin-bottom: 1rem;
        letter-spacing: -0.01em;
    }

    .btn-shop-now {
        background: rgba(255, 255, 255, 0.95);
        color: var(--midnight);
        padding: 0.75rem 2rem;
        border-radius: 99px;
        text-decoration: none;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        backdrop-filter: blur(4px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .category-card:hover .btn-shop-now {
        background: var(--midnight);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    /* --- Sidebar Filtre --- */
    .shop-layout {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 3.5rem;
        align-items: start;
        margin-top: 2rem;
    }

    .shop-sidebar {
        position: sticky;
        top: 100px;
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 2.25rem;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 20px 50px rgba(45, 41, 38, 0.02),
                    inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .filter-group {
        margin-bottom: 2.25rem;
        border-bottom: 1px solid var(--border-subtle);
        padding-bottom: 1.75rem;
    }

    .filter-group:last-of-type {
        border-bottom: none;
        padding-bottom: 0;
    }

    .filter-title {
        font-family: var(--font-display);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 800;
        margin-bottom: 1.25rem;
        color: var(--midnight);
    }

    .filter-content {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    /* Custom Checkbox/Radio styling */
    .filter-checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        font-size: 0.875rem;
        cursor: pointer;
        color: var(--text-main);
        font-weight: 500;
        transition: color 0.2s ease;
        position: relative;
    }

    .filter-checkbox-label:hover {
        color: #000000;
    }

    .filter-checkbox-label input[type="checkbox"],
    .filter-checkbox-label input[type="radio"] {
        appearance: none;
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        border: 2px solid var(--border-bold);
        border-radius: 6px;
        outline: none;
        cursor: pointer;
        display: grid;
        place-content: center;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        background: #ffffff;
    }

    .filter-checkbox-label input[type="radio"] {
        border-radius: 50%;
    }

    .filter-checkbox-label input[type="checkbox"]::before {
        content: "";
        width: 10px;
        height: 10px;
        transform: scale(0);
        transition: 0.2s transform ease-in-out;
        box-shadow: inset 1em 1em var(--midnight);
        background-color: var(--midnight);
        transform-origin: center;
        clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
    }

    .filter-checkbox-label input[type="radio"]::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        transform: scale(0);
        transition: 0.2s transform ease-in-out;
        background-color: var(--midnight);
    }

    .filter-checkbox-label input:checked {
        border-color: var(--midnight);
        background: #ffffff;
    }

    .filter-checkbox-label input:checked::before {
        transform: scale(1);
    }

    .price-range-inputs {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .price-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        border: 1.5px solid var(--border-subtle);
        background: rgba(255, 255, 255, 0.5);
        font-size: 0.8125rem;
        font-family: var(--font-body);
        color: var(--midnight);
        outline: none;
        transition: all 0.3s;
    }

    .price-input:focus {
        background: #ffffff;
        border-color: var(--midnight);
        box-shadow: 0 0 0 4px rgba(45, 41, 38, 0.04);
    }

    .nav-select {
        width: 100%;
        background: rgba(255, 255, 255, 0.5);
        border: 1.5px solid var(--border-subtle);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--midnight);
        outline: none;
        cursor: pointer;
        transition: all 0.3s;
    }

    .nav-select:focus,
    .nav-select:hover {
        background: #ffffff;
        border-color: var(--midnight);
    }

    .btn-apply-filters {
        width: 100%;
        background: var(--midnight);
        color: #ffffff;
        border: none;
        padding: 0.95rem;
        border-radius: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        margin-top: 0.5rem;
        box-shadow: 0 10px 20px rgba(45, 41, 38, 0.1);
    }

    .btn-apply-filters:hover {
        background: #000000;
        transform: translateY(-2px);
        box-shadow: 0 15px 25px rgba(45, 41, 38, 0.2);
    }

    /* --- Dynamic Product Grid --- */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
        margin-bottom: 5rem;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
        margin: 5rem 0;
    }

    .page-link {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid var(--border-subtle);
        border-radius: 12px;
        text-decoration: none;
        color: var(--midnight);
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        background: #ffffff;
    }

    .page-link:hover {
        border-color: var(--midnight);
        transform: translateY(-1px);
    }

    .page-link.active {
        background: var(--midnight);
        color: #ffffff;
        border-color: var(--midnight);
        box-shadow: 0 8px 20px rgba(45, 41, 38, 0.15);
    }

    .empty-gallery {
        text-align: center;
        padding: 8rem 2rem;
        border: 1px dashed var(--border-bold);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.3);
    }

    /* --- Sidebar Overlay --- */
    .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 2500;
        transition: opacity 0.3s ease;
    }

    /* --- Beautiful Minimalist Product Card --- */
    .product-card {
        background: transparent;
        transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
        position: relative;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        border: none !important;
        border-radius: 0 !important;
        overflow: visible !important;
        box-shadow: none !important;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: none !important;
    }

    .visual-container {
        aspect-ratio: 4 / 5;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .product-card:hover .product-img {
        transform: scale(1.05);
    }

    .info-container {
        padding: 0.75rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .product-name {
        font-family: var(--font-body);
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--midnight);
        margin-bottom: 0.25rem;
    }

    .price-tag {
        font-weight: 600;
        color: var(--midnight);
        font-size: 1rem;
    }

    .glass-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        z-index: 10;
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        background: rgba(255, 255, 255, 0.8);
        color: var(--midnight);
    }

    .card-emoji {
        font-size: 4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        background-color: #f1f5f9;
        color: #000;
    }

    /* --- Quick Add Form & Button --- */
    .quick-add-form {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 0.75rem;
        transform: translateY(101%);
        transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        z-index: 30;
    }

    .visual-container:hover .quick-add-form {
        transform: translateY(0);
    }

    .btn-quick-add {
        width: 100%;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        color: var(--midnight);
        padding: 0.6rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .btn-quick-add:hover {
        background: var(--midnight);
        color: #fff;
        border-color: var(--midnight);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    /* --- Shimmer Skeleton Loader --- */
    .loading-shimmer .shimmer-card {
        background: transparent;
        display: flex;
        flex-direction: column;
    }

    .loading-shimmer .shimmer-visual {
        aspect-ratio: 4 / 5;
        background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: shimmerAnim 1.5s infinite;
        border-radius: 4px;
    }

    .loading-shimmer .shimmer-line {
        height: 12px;
        background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
        background-size: 200% 100%;
        animation: shimmerAnim 1.5s infinite;
        margin-top: 10px;
        border-radius: 4px;
    }

    .loading-shimmer .line-1 {
        width: 60%;
        margin-inline: auto;
    }

    .loading-shimmer .line-2 {
        width: 40%;
        margin-inline: auto;
        height: 16px;
        margin-top: 6px;
    }

    @@keyframes shimmerAnim {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* --- Interactive Dual Range Price Slider --- */
    .range-thumb-input {
        outline: none;
    }

    .range-thumb-input::-webkit-slider-thumb {
        pointer-events: auto;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid var(--midnight);
        cursor: pointer;
        -webkit-appearance: none;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        transition: transform 0.2s, background-color 0.2s;
    }

    .range-thumb-input::-webkit-slider-thumb:hover {
        transform: scale(1.2);
        background: var(--midnight);
    }

    .range-thumb-input::-moz-range-thumb {
        pointer-events: auto;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid var(--midnight);
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        transition: transform 0.2s, background-color 0.2s;
    }

    .range-thumb-input::-moz-range-thumb:hover {
        transform: scale(1.2);
        background: var(--midnight);
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive styling */
    @@media (max-width: 1280px) {
        .product-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @@media (max-width: 1024px) {
        .shop-layout { grid-template-columns: 1fr; }
        .shop-sidebar {
            position: fixed;
            top: 0;
            left: -340px;
            width: 320px;
            height: 100vh;
            z-index: 2600;
            overflow-y: auto;
            border-radius: 0;
            background: #ffffff;
            box-shadow: var(--shadow-lg);
            transition: left 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .shop-sidebar.active {
            left: 0;
        }
        body.sidebar-open .sidebar-overlay {
            display: block;
        }
        .product-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @@media (max-width: 640px) {
        .category-grid { grid-template-columns: 1fr; gap: 1.5rem; }
        .product-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
        .hero-section { border-radius: 0; margin-top: -2rem; }
    }
</style>

@if (string.IsNullOrEmpty(Context.Request.Query["categoryFilter"]) && string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
{
    <div class="hero-section">
        <div class="hero-bg"></div>
        <div class="hero-content">
            <span class="hero-tag">Colecția Premium</span>
            <h1 class="hero-title">Înalță-ți Stilul de Viață</h1>
            <p class="hero-subtitle">Lux pentru tine și stilul tău de viață.</p>
            <a href="#collection" class="hero-cta">
                Explorează Colecția
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <polyline points="19 12 12 19 5 12"></polyline>
                </svg>
            </a>
        </div>
    </div>

    <div class="container">
        <div class="category-grid">
            @if (ViewBag.Categories != null)
            {
                var featuredCategories = ((IEnumerable<OnlineStore.Domain.Entities.Category>)ViewBag.Categories).Where(c => c.IsFeatured).ToList();
                foreach (var cat in featuredCategories)
                {
                    <div class="category-card">
                        @if (!string.IsNullOrEmpty(cat.ImageUrl))
                        {
                            <img src="@cat.ImageUrl" class="category-img" alt="@cat.Name">
                        }
                        else
                        {
                            <div class="category-img" style="background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 2rem;">📦</div>
                        }
                        <div class="category-overlay">
                            <h2 class="category-name">@(categoryDisplayNames.TryGetValue(cat.Name, out var catName) ? catName : cat.Name)</h2>
                            <a href="/Home?categoryFilter=@cat.Name#collection" class="btn-shop-now">Explorează</a>
                        </div>
                    </div>
                }
            }
            @if (ViewBag.Categories == null || !((IEnumerable<OnlineStore.Domain.Entities.Category>)ViewBag.Categories).Any(c => c.IsFeatured))
            {
                <div style="grid-column: span 3; text-align: center; padding: 4rem; border: 1px dashed var(--border-bold); border-radius: 24px;">
                    <p style="color: var(--text-muted);">Nu există categorii recomandate. Adaugă-le în panoul de administrare!</p>
                </div>
            }
        </div>
    </div>
}

<div id="collection" class="container shop-layout">
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>
    <aside class="shop-sidebar" id="shopSidebar">
        <form id="sidebarFilterForm" method="get" asp-controller="Home" asp-action="Index" asp-fragment="collection">
            <input type="hidden" name="searchQuery" value="@Context.Request.Query["searchQuery"]" />
            
            <div class="filter-group">
                <h4 class="filter-title">Categorii</h4>
                <div class="filter-content">
                    <label class="filter-checkbox-label">
                        <input type="radio" name="categoryFilter" value="All" @(string.IsNullOrEmpty(Context.Request.Query["categoryFilter"]) || Context.Request.Query["categoryFilter"].ToString().Equals("All", StringComparison.OrdinalIgnoreCase) ? "checked" : "") onchange="this.form.submit()">
                        Toate Colecțiile
                    </label>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (IEnumerable<OnlineStore.Domain.Entities.Category>)ViewBag.Categories)
                        {
                            <label class="filter-checkbox-label">
                                <input type="radio" name="categoryFilter" value="@cat.Name" @(Context.Request.Query["categoryFilter"].ToString().Equals(cat.Name, StringComparison.OrdinalIgnoreCase) ? "checked" : "") onchange="this.form.submit()">
                                @(categoryDisplayNames.TryGetValue(cat.Name, out var catName) ? catName : cat.Name)
                            </label>
                        }
                    }
                </div>
            </div>

            <div class="filter-group">
                <h4 class="filter-title">Interval Preț</h4>
                <div class="filter-content">
                    <div class="price-slider-container" style="margin-top: 0.5rem; position: relative; padding-bottom: 0.5rem;">
                        <div class="price-range-inputs" style="margin-bottom: 1.25rem;">
                            <input type="number" id="minPriceInput" name="minPrice" placeholder="Min" class="price-input" value="@Context.Request.Query["minPrice"]" style="width: 90px; text-align: center;" />
                            <span style="color: var(--border-bold)">-</span>
                            <input type="number" id="maxPriceInput" name="maxPrice" placeholder="Max" class="price-input" value="@Context.Request.Query["maxPrice"]" style="width: 90px; text-align: center;" />
                        </div>
                        <div class="slider-track-wrap" style="position: relative; height: 4px; background: rgba(0,0,0,0.06); border-radius: 99px; margin-inline: 4px;">
                            <div class="slider-track" id="sliderTrack" style="position: absolute; height: 100%; background: var(--midnight); border-radius: 99px; left: 0%; width: 100%;"></div>
                            <input type="range" id="minPriceRange" min="0" max="50000" step="50" value="@(string.IsNullOrEmpty(Context.Request.Query["minPrice"]) ? "0" : Context.Request.Query["minPrice"].ToString())" class="range-thumb-input" style="position: absolute; width: 100%; top: -6px; left: 0; height: 16px; pointer-events: none; background: none; -webkit-appearance: none; margin: 0;" />
                            <input type="range" id="maxPriceRange" min="0" max="50000" step="50" value="@(string.IsNullOrEmpty(Context.Request.Query["maxPrice"]) ? "50000" : Context.Request.Query["maxPrice"].ToString())" class="range-thumb-input" style="position: absolute; width: 100%; top: -6px; left: 0; height: 16px; pointer-events: none; background: none; -webkit-appearance: none; margin: 0;" />
                        </div>
                    </div>
                </div>
            </div>

            @{
                var currentCategory = Context.Request.Query["categoryFilter"].ToString();
            }

            @if (currentCategory.Equals("Clothing", StringComparison.OrdinalIgnoreCase))
            {
                <div class="filter-group">
                    <h4 class="filter-title">Mărimi</h4>
                    <div class="filter-content">
                        @{
                            string[] sizes = { "XS", "S", "M", "L", "XL", "XXL" };
                            var selectedSizesList = Context.Request.Query["selectedSizes"].ToList();
                        }
                        @foreach (var size in sizes)
                        {
                            <label class="filter-checkbox-label">
                                <input type="checkbox" name="selectedSizes" value="@size" @(selectedSizesList.Contains(size, StringComparer.OrdinalIgnoreCase) ? "checked" : "") onchange="this.form.submit()">
                                @size
                            </label>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <h4 class="filter-title">Culori</h4>
                    <div class="filter-content">
                        @{
                            string[] colorsList = { "Black", "White", "Beige", "Navy", "Charcoal", "Sage" };
                            var selectedColorsList = Context.Request.Query["selectedColors"].ToList();
                            var colorDisplayNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                            {
                                { "Black", "Negru" },
                                { "White", "Alb" },
                                { "Beige", "Bej" },
                                { "Navy", "Bleumarin" },
                                { "Charcoal", "Cărbune" },
                                { "Sage", "Salvie" }
                            };
                        }
                        @foreach (var color in colorsList)
                        {
                            <label class="filter-checkbox-label">
                                <input type="checkbox" name="selectedColors" value="@color" @(selectedColorsList.Contains(color, StringComparer.OrdinalIgnoreCase) ? "checked" : "") onchange="this.form.submit()">
                                @(colorDisplayNames.TryGetValue(color, out var name) ? name : color)
                            </label>
                        }
                    </div>
                </div>
            }

            <div class="filter-group">
                <h4 class="filter-title">Sortează după</h4>
                <div class="filter-content">
                    <select name="sortStrategy" class="nav-select" style="width: 100%; min-width: 0;" onchange="this.form.submit()">
                        <option value="">Noutăți</option>
                        <option value="PriceAsc" selected="@(Context.Request.Query["sortStrategy"] == "PriceAsc")">Preț: crescător</option>
                        <option value="PriceDesc" selected="@(Context.Request.Query["sortStrategy"] == "PriceDesc")">Preț: descrescător</option>
                        <option value="Name" selected="@(Context.Request.Query["sortStrategy"] == "Name")">Alfabetic</option>
                        <option value="Stock" selected="@(Context.Request.Query["sortStrategy"] == "Stock")">În stoc mai întâi</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn-apply-filters">Aplică Filtre</button>
            <a href="/Home" style="display: block; text-align: center; margin-top: 1.25rem; font-size: 0.8rem; color: var(--text-muted); text-decoration: underline; font-weight: 500;">Resetează filtrele</a>
        </form>
    </aside>

    <main class="shop-content">
        @if (!Model.Any())
        {
            <div class="empty-gallery">
                <div style="font-size: 3rem; opacity: 0.25; margin-bottom: 2rem;">✧</div>
                <h3 style="font-family: var(--font-elegant); font-size: 2rem; margin-bottom: 0.5rem;">Niciun rezultat găsit</h3>
                <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 0.9rem;">Încearcă să ajustezi filtrele sau termenii de căutare.</p>
                <a asp-action="Index" class="nav-link" style="text-decoration: underline; font-weight: 700;">Resetează Toate Filtrele</a>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        }

        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination-container">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-action="Index" asp-fragment="collection"
                       asp-route-page="@i" 
                       asp-route-searchQuery="@ViewBag.SearchQuery" 
                       asp-route-categoryFilter="@ViewBag.CategoryFilter"
                       asp-route-sortStrategy="@ViewBag.SortStrategy"
                       asp-route-minPrice="@ViewBag.MinPrice"
                       asp-route-maxPrice="@ViewBag.MaxPrice"
                       asp-route-selectedSizes="@ViewBag.SelectedSizes"
                       asp-route-selectedColors="@ViewBag.SelectedColors"
                       class="page-link @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
                }
            </div>
        }
    </main>
</div>

<script>
    function initPriceSlider() {
        const minRange = document.getElementById('minPriceRange');
        const maxRange = document.getElementById('maxPriceRange');
        const minInput = document.getElementById('minPriceInput');
        const maxInput = document.getElementById('maxPriceInput');
        const track = document.getElementById('sliderTrack');

        if (!minRange || !maxRange || !minInput || !maxInput || !track) return;

        const minVal = parseInt(minRange.min);
        const maxVal = parseInt(minRange.max);

        function updateSlider() {
            let val1 = parseInt(minRange.value);
            let val2 = parseInt(maxRange.value);

            if (val1 > val2 - 250) {
                if (document.activeElement === minRange) {
                    minRange.value = val2 - 250;
                    val1 = val2 - 250;
                } else {
                    maxRange.value = val1 + 250;
                    val2 = val1 + 250;
                }
            }

            minInput.value = val1;
            maxInput.value = val2;

            const pct1 = ((val1 - minVal) / (maxVal - minVal)) * 100;
            const pct2 = ((val2 - minVal) / (maxVal - minVal)) * 100;

            track.style.left = pct1 + '%';
            track.style.width = (pct2 - pct1) + '%';
        }

        minRange.addEventListener('input', updateSlider);
        maxRange.addEventListener('input', updateSlider);
        
        minInput.addEventListener('change', () => {
            minRange.value = minInput.value;
            updateSlider();
            const sidebarForm = document.getElementById('sidebarFilterForm');
            if (sidebarForm) filterProductsAjax(sidebarForm);
        });
        
        maxInput.addEventListener('change', () => {
            maxRange.value = maxInput.value;
            updateSlider();
            const sidebarForm = document.getElementById('sidebarFilterForm');
            if (sidebarForm) filterProductsAjax(sidebarForm);
        });

        // Trigger filter on mouse release (mouseup) for smooth sliding without heavy queries
        minRange.addEventListener('change', () => {
            const sidebarForm = document.getElementById('sidebarFilterForm');
            if (sidebarForm) filterProductsAjax(sidebarForm);
        });
        maxRange.addEventListener('change', () => {
            const sidebarForm = document.getElementById('sidebarFilterForm');
            if (sidebarForm) filterProductsAjax(sidebarForm);
        });

        updateSlider();
    }

    async function filterProductsAjax(form) {
        const formData = new FormData(form);
        const params = new URLSearchParams(formData);
        
        // Synced values from navbar search form if available
        const navbarSearch = document.getElementById('navSearchInput');
        if (navbarSearch && !params.has('searchQuery')) {
            params.set('searchQuery', navbarSearch.value);
        }

        // Clean up empty params
        for (const [key, value] of [...params.entries()]) {
            if (!value) params.delete(key);
        }
        
        const url = `/Home?${params.toString()}#collection`;

        // 1. Show Shimmer Skeleton in the product grid
        const shopContent = document.querySelector('.shop-content');
        if (shopContent) {
            shopContent.innerHTML = `
                <div class="product-grid loading-shimmer">
                    ${Array(8).fill(`
                        <div class="shimmer-card">
                            <div class="shimmer-visual"></div>
                            <div class="shimmer-line line-1"></div>
                            <div class="shimmer-line line-2"></div>
                        </div>
                    `).join('')}
                </div>
            `;
        }

        try {
            // 2. Fetch the new content
            const response = await fetch(`/Home?${params.toString()}`);
            const html = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            // 3. Extract and replace the main shop-content
            const newShopContent = doc.querySelector('.shop-content');
            if (newShopContent && shopContent) {
                shopContent.innerHTML = newShopContent.innerHTML;
            }

            // 4. Update the URL without reloading
            history.pushState(null, '', url);

            // 5. Reinitialize slider
            initPriceSlider();
            
            // Sync search query in navbar if updated
            const newSearchInput = doc.querySelector('#navSearchInput');
            const layoutSearchInput = document.getElementById('navSearchInput');
            if (newSearchInput && layoutSearchInput && layoutSearchInput !== document.activeElement) {
                layoutSearchInput.value = newSearchInput.value;
            }
        } catch (err) {
            console.error('Error fetching filtered products:', err);
            form.submit();
        }
    }

    async function loadPageAjax(url) {
        const shopContent = document.querySelector('.shop-content');
        if (shopContent) {
            shopContent.innerHTML = `
                <div class="product-grid loading-shimmer">
                    ${Array(8).fill(`
                        <div class="shimmer-card">
                            <div class="shimmer-visual"></div>
                            <div class="shimmer-line line-1"></div>
                            <div class="shimmer-line line-2"></div>
                        </div>
                    `).join('')}
                </div>
            `;
        }
        try {
            const response = await fetch(url);
            const html = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newShopContent = doc.querySelector('.shop-content');
            if (newShopContent && shopContent) {
                shopContent.innerHTML = newShopContent.innerHTML;
            }
            history.pushState(null, '', url);
            initPriceSlider();
            
            const collection = document.getElementById('collection');
            if (collection) {
                collection.scrollIntoView({ behavior: 'smooth' });
            }
        } catch (err) {
            window.location.href = url;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const sidebarForm = document.getElementById('sidebarFilterForm');
        const navbarForm = document.getElementById('liveFilterForm');

        if (sidebarForm) {
            sidebarForm.addEventListener('submit', (e) => {
                e.preventDefault();
                filterProductsAjax(sidebarForm);
            });
            
            // Intercept form submissions triggered by 'onchange="this.form.submit()"'
            sidebarForm.addEventListener('change', (e) => {
                if (e.target.classList.contains('range-thumb-input') || e.target.classList.contains('price-input')) {
                    return; 
                }
                filterProductsAjax(sidebarForm);
            });

            // Override form submit prototype so debounced submits invoke Ajax
            sidebarForm.submit = () => filterProductsAjax(sidebarForm);
        }

        if (navbarForm) {
            navbarForm.addEventListener('submit', (e) => {
                e.preventDefault();
                filterProductsAjax(navbarForm);
            });
            navbarForm.submit = () => filterProductsAjax(navbarForm);
        }

        // Handle pagination links with Ajax
        document.addEventListener('click', (e) => {
            const link = e.target.closest('.pagination-container .page-link');
            if (link) {
                e.preventDefault();
                const href = link.getAttribute('href');
                if (href) {
                    loadPageAjax(href);
                }
            }
        });

        initPriceSlider();
    });
</script>
