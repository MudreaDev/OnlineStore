@model OnlineStore.Domain.Entities.ProductReview

<div class="review-item" style="margin-bottom: 2rem; border-left: 2px solid var(--border-subtle); padding-left: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
        <div>
            <span style="font-weight: 700; color: var(--midnight); font-size: 0.9rem;">@Model.UserName</span>
            <span style="font-size: 0.75rem; color: var(--text-muted); margin-left: 1rem;">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
        </div>
        <div style="color: #fbbf24; font-size: 0.8rem;">
            @for (int i = 0; i < Model.Rating; i++) { <span>★</span> }
            @for (int i = Model.Rating; i < 5; i++) { <span>☆</span> }
        </div>
    </div>
    
    <p style="font-size: 0.875rem; color: var(--text-main); margin-bottom: 1rem; line-height: 1.5;">@Model.Content</p>
    
    <button onclick="toggleReplyForm('@Model.Id')" style="background: none; border: none; color: var(--accent-primary); font-size: 0.75rem; font-weight: 700; cursor: pointer; padding: 0;">Reply</button>

    <div id="reply-form-@Model.Id" style="display: none; margin-top: 1rem; background: var(--bg-base); padding: 1rem; border-radius: 8px;">
        <form asp-action="AddReview" method="post">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <input type="hidden" name="parentId" value="@Model.Id" />
            <input type="hidden" name="rating" value="5" /> <!-- Rating implicit pt reply -->
            <textarea name="content" required placeholder="Write a reply..." style="width: 100%; min-height: 60px; padding: 0.5rem; border-radius: 6px; border: 1px solid var(--border-bold); font-size: 0.8rem; margin-bottom: 0.5rem;"></textarea>
            <button type="submit" style="background: var(--midnight); color: #fff; padding: 0.4rem 1rem; border: none; border-radius: 6px; font-size: 0.75rem; cursor: pointer;">Post Reply</button>
        </form>
    </div>

    @if (Model.Replies != null && Model.Replies.Any())
    {
        <div class="replies" style="margin-top: 1.5rem;">
            @foreach (var reply in Model.Replies)
            {
                <partial name="_ReviewItem" model="reply" />
            }
        </div>
    }
</div>

<script>
    if (typeof toggleReplyForm === 'undefined') {
        window.toggleReplyForm = function(id) {
            const form = document.getElementById('reply-form-' + id);
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
    }
</script>
