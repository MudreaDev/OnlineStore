@model OnlineStore.WebUI.Models.CartViewModel
@using OnlineStore.Domain.Singleton

@{
    ViewData["Title"] = "Shopping Cart";
    var cartItems = ViewBag.CartItems as List<(OnlineStore.Domain.Entities.Product Product, int Quantity, string? Size, string? Color)>;
    decimal total = ViewBag.Total ?? 0;
    decimal freeShippingThreshold = ApplicationConfigurationManager.Instance.FreeShippingThreshold;
}

<style>
    .cart-page {
        padding-top: 3rem;
        padding-bottom: 8rem;
    }

    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 4rem;
        align-items: start;
    }

    .cart-title {
        font-family: var(--font-elegant);
        font-size: 2.5rem;
        color: var(--midnight);
        margin-bottom: 2rem;
        grid-column: span 2;
        letter-spacing: -0.02em;
    }

    /* --- Cart Items --- */
    .cart-items-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .cart-item-luxury {
        display: grid;
        grid-template-columns: 100px 1fr auto;
        gap: 2rem;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid var(--border-subtle);
        border-radius: 24px;
        padding: 1.5rem;
        align-items: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(5px);
    }

    .cart-item-luxury:hover {
        border-color: var(--midnight);
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(45, 41, 38, 0.04);
        background: #fff;
    }

    .item-visual {
        width: 100px;
        height: 100px;
        border-radius: 16px;
        background: #fff;
        border: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .item-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .item-emoji { font-size: 2.5rem; }

    .item-info h4 {
        font-family: var(--font-display);
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--midnight);
        margin-bottom: 0.375rem;
    }

    .item-info .item-cat {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--accent-primary);
        letter-spacing: 0.1em;
        display: block;
        margin-bottom: 0.25rem;
    }

    .item-controls {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .qty-wrap {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        background: var(--bg-base);
        padding: 0.5rem 0.875rem;
        border-radius: 12px;
        font-weight: 700;
        border: 1px solid var(--border-subtle);
    }

    .qty-btn {
        background: none;
        border: none;
        color: var(--midnight);
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0 0.25rem;
        transition: color 0.2s;
    }

    .qty-btn:hover { color: var(--accent-primary); }
    .qty-btn:disabled { opacity: 0.3; cursor: not-allowed; }

    .item-price {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.125rem;
        color: var(--midnight);
        min-width: 90px;
        text-align: right;
    }

    .remove-btn {
        background: none;
        border: 1px solid var(--border-subtle);
        color: var(--text-muted);
        cursor: pointer;
        padding: 0.625rem;
        border-radius: 12px;
        transition: var(--transition-smooth);
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
    }

    .remove-btn:hover {
        background: #fee2e2;
        color: #ef4444;
        border-color: #fca5a5;
        transform: scale(1.05);
    }

    /* --- Sticky Summary --- */
    .summary-glass {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(20px);
        border: 1px solid var(--border-subtle);
        border-radius: 28px;
        padding: 2.25rem;
        position: sticky;
        top: 120px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.02);
    }

    .summary-title {
        font-family: var(--font-display);
        font-size: 1.375rem;
        font-weight: 800;
        color: var(--midnight);
        margin-bottom: 2rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        font-size: 0.875rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .summary-total {
        margin-top: 1.75rem;
        padding-top: 1.75rem;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        justify-content: space-between;
        font-family: var(--font-display);
        font-size: 1.375rem;
        font-weight: 800;
        color: var(--midnight);
    }

    .btn-checkout {
        display: block;
        width: 100%;
        background: var(--midnight);
        color: #fff;
        text-align: center;
        padding: 1.25rem;
        border-radius: 16px;
        margin-top: 2rem;
        font-family: var(--font-display);
        font-weight: 800;
        text-decoration: none;
        transition: var(--transition-smooth);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border: none;
        cursor: pointer;
        box-shadow: 0 10px 25px rgba(45, 41, 38, 0.1);
    }

    .btn-checkout:hover {
        background: #000;
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    }

    .shipping-notice {
        margin-top: 1.5rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        text-align: center;
        line-height: 1.6;
    }

    .empty-state {
        text-align: center;
        padding: 8rem 0;
        grid-column: span 2;
    }

    /* Option Tiles styling */
    .checkout-field {
        margin-bottom: 1.5rem;
        text-align: left;
    }
    .field-label {
        font-size: 0.8125rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--midnight);
        margin-bottom: 0.5rem;
        display: block;
        font-family: var(--font-display);
    }
    .option-tile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }
    .option-tile {
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 0.875rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(5px);
        user-select: none;
    }
    .option-tile:hover {
        border-color: var(--midnight);
        background: rgba(255, 255, 255, 0.8);
        transform: translateY(-1px);
    }
    .option-tile.active {
        background: var(--midnight);
        border-color: var(--midnight);
        color: #fff;
        box-shadow: 0 8px 16px rgba(45, 41, 38, 0.1);
        transform: translateY(-2px);
    }
    .option-tile.active .tile-icon {
        background: rgba(255,255,255,0.15);
        color: #fff;
    }
    .tile-icon {
        font-size: 1.15rem;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(45,41,38,0.03);
        border-radius: 8px;
        transition: background 0.3s;
    }
    .tile-label {
        font-weight: 700;
        font-size: 0.8125rem;
        letter-spacing: 0.02em;
    }
    .tile-desc {
        font-size: 0.7rem;
        color: var(--text-muted);
        display: block;
        margin-top: 0.15rem;
    }
    .option-tile.active .tile-desc {
        color: rgba(255,255,255,0.7);
    }
    .checkout-input {
        width: 100%;
        padding: 1rem 1.25rem;
        border-radius: 14px;
        border: 1px solid var(--border-subtle);
        background: rgba(255, 255, 255, 0.5);
        color: var(--midnight);
        font-weight: 500;
        font-size: 0.875rem;
        font-family: inherit;
        outline: none;
        transition: all 0.3s ease;
        box-shadow: 0 2px 6px rgba(0,0,0,0.01);
    }
    .checkout-input:focus {
        border-color: var(--midnight);
        background: #fff;
        box-shadow: 0 0 0 4px rgba(45, 41, 38, 0.05);
    }
    .checkout-textarea {
        min-height: 90px;
        resize: vertical;
    }

    @@media (max-width: 900px) {
        .cart-layout { grid-template-columns: 1fr; gap: 3rem; }
        .summary-glass { position: static; }
    }
</style>

<div class="container cart-page fade-in">
    <div class="cart-layout">
        <div style="display: flex; justify-content: space-between; align-items: baseline; grid-column: span 2;">
            <h1 class="cart-title" style="margin-bottom: 1rem;">Shopping Cart</h1>
            <div style="display: flex; gap: 1rem;">
                <!-- Undo / Redo Actions -->
                <form asp-action="Undo" method="post">
                    <button type="submit" class="btn-checkout" style="padding: 0.5rem 1.5rem; margin-top: 0; background: var(--text-muted); width: auto;" title="Undo Last Cart Action">
                        ↩ Undo
                    </button>
                </form>
                <form asp-action="Redo" method="post">
                    <button type="submit" class="btn-checkout" style="padding: 0.5rem 1.5rem; margin-top: 0; background: var(--text-muted); width: auto;" title="Redo Last Cart Action">
                        Redo ↪
                    </button>
                </form>
            </div>
        </div>

        @if (cartItems == null || !cartItems.Any())
        {
                <div class="empty-state">
                    <div style="font-size: 4rem; opacity: 0.2; margin-bottom: 2rem;">🧳</div>
                    <h3 style="font-family: var(--font-elegant); font-size: 2rem; color: var(--midnight);">Your cart is empty</h3>
                    <p style="color: var(--text-muted); margin-bottom: 2.5rem;">Explore our collection to find your next essential pieces.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn-checkout" style="display: inline-block; width: auto; padding: 1rem 3rem;">Shop Collection</a>
                </div>
        }
        else
        {
                <div class="cart-items-list">
                @foreach (var item in cartItems)
                {
                    var product = item.Product;
                    var typeName = product.GetType().Name.Replace("Product", "");
                    var mainImage = product.Images.FirstOrDefault(i => i.IsMain) ?? product.Images.FirstOrDefault();
                    var emoji = typeName switch
                    {
                        "Electronic" => "🔌",
                        "Clothing" => "👕",
                        "Vehicle" => "🚗",
                        _ => "📦"
                    };

                            <div class="cart-item-luxury">
                                <div class="item-visual">
                            @if (mainImage != null)
                            {
                                            <img src="@mainImage.ImageUrl" class="item-img" alt="@product.Name">
                            }
                            else
                            {
                                            <span class="item-emoji">@emoji</span>
                            }
                                </div>

                                <div class="item-info">
                                    <span class="item-cat">Handcrafted @typeName</span>
                                    <h4>@product.Name</h4>
                            @if (!string.IsNullOrEmpty(item.Size) || !string.IsNullOrEmpty(item.Color))
                            {
                                            <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
                                    @if (!string.IsNullOrEmpty(item.Size))
                                    {
                                                        <span style="font-size: 0.75rem; color: var(--text-main); background: var(--bg-base); padding: 2px 8px; border-radius: 6px;">Size: <b>@item.Size</b></span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Color))
                                    {
                                                        <span style="font-size: 0.75rem; color: var(--text-main); background: var(--bg-base); padding: 2px 8px; border-radius: 6px;">Color: <b>@item.Color</b></span>
                                    }
                                            </div>
                            }
                                    <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">Status: Ready for shipment</p>
                                </div>

                                <div class="item-controls">
                                    @{
                                        // Create a unique key for identifying the UI elements of this item row
                                        var itemKey = $"{product.Id}_{item.Size}_{item.Color}".Replace("-", "").Replace(" ", "");
                                    }
                                    <div class="qty-wrap" id="item-row-@itemKey">
                                        <button type="button" class="qty-btn" onclick="updateQty(-1, '@product.Id', '@item.Size', '@item.Color')" id="dec-@itemKey" @(item.Quantity <= 1 ? "disabled" : "")>−</button>
                                        <span id="qty-@itemKey">@item.Quantity</span>
                                        <button type="button" class="qty-btn" onclick="updateQty(1, '@product.Id', '@item.Size', '@item.Color')" id="inc-@itemKey" @(item.Quantity >= product.Stock ? "disabled" : "")>+</button>
                                    </div>

                                    <div class="item-price" id="total-@itemKey">@((product.Price * item.Quantity).ToString("C0"))</div>

                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="id" value="@product.Id" />
                                        <input type="hidden" name="size" value="@item.Size" />
                                        <input type="hidden" name="color" value="@item.Color" />
                                        <button type="submit" class="remove-btn" title="Remove from cart">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </div>
                }
                </div>

                <aside class="summary-glass">
                    <h3 class="summary-title">Order Summary</h3>

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>@total.ToString("C2")</span>
                    </div>

                    <div class="summary-row">
                        <span>Shipping</span>
                        <span>@(total >= freeShippingThreshold ? "Complimentary" : "€15.00")</span>
                    </div>

                @if (total < freeShippingThreshold)
                {
                            <div style="background: rgba(5, 150, 105, 0.05); padding: 0.75rem; border-radius: 12px; font-size: 0.7rem; color: var(--accent-primary); font-weight: 700; margin-bottom: 2rem; border: 1px solid rgba(5, 150, 105, 0.1);">
                                Add @((freeShippingThreshold - total).ToString("C2")) for Complimentary Shipping
                            </div>
                }

                    <div class="summary-total">
                        <span>Total</span>
                        <span id="overall-cart-total">@((total >= freeShippingThreshold ? total : total + 15).ToString("C2"))</span>
                    </div>

                    <form asp-action="Checkout" method="post">
                        @inject OnlineStore.Application.Repositories.DbUserRepository UserRepo
                        @{
                            var userIdStr_form = Context.Session.GetString("UserId");
                            var customerUser = !string.IsNullOrEmpty(userIdStr_form) ? UserRepo.GetById(Guid.Parse(userIdStr_form)) as OnlineStore.Domain.Entities.Customer : null;
                            var defaultAddress = customerUser?.ShippingAddress ?? "";
                        }
                        
                        <div class="checkout-field">
                            <label class="field-label">Adresă de Livrare</label>
                            <textarea name="shippingAddress" required placeholder="Strada, Număr, Oraș, Județ..." class="checkout-input checkout-textarea">@defaultAddress</textarea>
                        </div>

                        <div class="checkout-field">
                            <label class="field-label">Număr de Telefon</label>
                            <input type="tel" name="phoneNumber" placeholder="07xx xxx xxx" class="checkout-input" />
                        </div>

                        <div class="checkout-field">
                            <label class="field-label">Metodă de Plată (Adapter Pattern)</label>
                            <input type="hidden" name="paymentMethod" id="paymentMethod" value="PayPal" />
                            <div class="option-tile-grid" data-input-id="paymentMethod">
                                <div class="option-tile active" data-value="PayPal">
                                    <div class="tile-icon">💳</div>
                                    <div>
                                        <span class="tile-label">PayPal</span>
                                        <span class="tile-desc">Fast & Secure</span>
                                    </div>
                                </div>
                                <div class="option-tile" data-value="Stripe">
                                    <div class="tile-icon">⚡</div>
                                    <div>
                                        <span class="tile-label">Stripe</span>
                                        <span class="tile-desc">Credit Card</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="checkout-field">
                            <label class="field-label">Tip Magazin (Abstract Factory)</label>
                            <input type="hidden" name="storeType" id="storeType" value="Local" />
                            <div class="option-tile-grid" data-input-id="storeType">
                                <div class="option-tile active" data-value="Local">
                                    <div class="tile-icon">🏠</div>
                                    <div>
                                        <span class="tile-label">Local Store</span>
                                        <span class="tile-desc">Cash / Local</span>
                                    </div>
                                </div>
                                <div class="option-tile" data-value="Global">
                                    <div class="tile-icon">🌍</div>
                                    <div>
                                        <span class="tile-label">Global Store</span>
                                        <span class="tile-desc">PayPal / DHL</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="checkout-field">
                            <label class="field-label">Tip Livrare (Bridge Pattern)</label>
                            <input type="hidden" name="deliveryType" id="deliveryType" value="Home" />
                            <div class="option-tile-grid" data-input-id="deliveryType">
                                <div class="option-tile active" data-value="Home">
                                    <div class="tile-icon">📦</div>
                                    <div>
                                        <span class="tile-label">Livrare Acasă</span>
                                        <span class="tile-desc">To your doorstep</span>
                                    </div>
                                </div>
                                <div class="option-tile" data-value="Pickup">
                                    <div class="tile-icon">🏪</div>
                                    <div>
                                        <span class="tile-label">Punct Ridicare</span>
                                        <span class="tile-desc">From our center</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="checkout-field">
                            <label class="field-label">Furnizor Transport (Bridge Pattern)</label>
                            <input type="hidden" name="shippingProvider" id="shippingProvider" value="Courier" />
                            <div class="option-tile-grid" data-input-id="shippingProvider">
                                <div class="option-tile active" data-value="Courier">
                                    <div class="tile-icon">🚚</div>
                                    <div>
                                        <span class="tile-label">Curier Rapid</span>
                                        <span class="tile-desc">3-5 business days</span>
                                    </div>
                                </div>
                                <div class="option-tile" data-value="Postal">
                                    <div class="tile-icon">✉️</div>
                                    <div>
                                        <span class="tile-label">Poșta Română</span>
                                        <span class="tile-desc">Standard shipping</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn-checkout">Finalizare Comandă (Façade)</button>
                    </form>

                    <div class="shipping-notice">
                        Orders are processed within 24 hours. Free returns within 30 days for premium members.
                    </div>
                </aside>
        }
    </div>
</div>

<script>
    async function updateQty(adjustment, productId, size, color) {
        const key = (productId + '_' + size + '_' + color).replace(/-/g, '').replace(/ /g, '');
        const qtySpan = document.getElementById('qty-' + key);
        const currentQty = parseInt(qtySpan.innerText);
        const newQty = currentQty + adjustment;

        if (newQty < 1) return;

        const formData = new FormData();
        formData.append('id', productId);
        formData.append('quantity', newQty);
        formData.append('size', size);
        formData.append('color', color);

        try {
            const response = await fetch('@Url.Action("UpdateQuantity", "Cart")', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                // Update UI
                qtySpan.innerText = result.newQuantity;
                document.getElementById('total-' + key).innerText = result.itemTotalFormatted;
                document.getElementById('overall-cart-total').innerText = result.cartTotalFormatted;
                
                // Update button states
                document.getElementById('dec-' + key).disabled = (result.newQuantity <= 1);
                document.getElementById('inc-' + key).disabled = result.stockLimitReached;
                
                if (result.stockLimitReached && adjustment > 0) {
                     alert("Stoc maxim atins");
                }
            } else {
                alert(result.message || "Eroare la actualizarea cantității.");
            }
        } catch (e) {
            console.error("Cart error:", e);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.option-tile-grid').forEach(grid => {
            const inputId = grid.getAttribute('data-input-id');
            const hiddenInput = document.getElementById(inputId);
            
            grid.querySelectorAll('.option-tile').forEach(tile => {
                tile.addEventListener('click', () => {
                    grid.querySelectorAll('.option-tile').forEach(t => t.classList.remove('active'));
                    tile.classList.add('active');
                    hiddenInput.value = tile.getAttribute('data-value');
                });
            });
        });
    });
</script>
