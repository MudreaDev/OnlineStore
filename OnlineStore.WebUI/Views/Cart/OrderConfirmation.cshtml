@model OnlineStore.Domain.Entities.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<style>
    :root {
        --confetti-green: #22c55e;
        --confetti-dark: #1a1a1a;
        --confetti-border: #e5e7eb;
    }

    .confetti-page {
        text-align: center;
        padding: 6rem 1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .success-icon {
        width: 100px;
        height: 100px;
        background: var(--confetti-green);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 3rem;
        font-size: 3rem;
        animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes popIn {
        0% { transform: scale(0); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }

    .confetti-title {
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        margin-bottom: 1rem;
        color: var(--confetti-dark);
    }

    .confetti-subtitle {
        color: #64748b;
        font-size: 1.125rem;
        margin-bottom: 4rem;
    }

    .order-details-card {
        background: #fff;
        border: 1px solid var(--confetti-border);
        border-radius: 24px;
        padding: 2.5rem;
        text-align: left;
        margin-bottom: 4rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 1.25rem 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #64748b;
        font-size: 0.9375rem;
        font-weight: 500;
    }

    .detail-value {
        color: var(--confetti-dark);
        font-weight: 700;
    }

    .btn-row {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        margin-top: 2rem;
    }

    .btn-main {
        background: var(--confetti-dark);
        color: #fff !important;
        padding: 1rem 2.5rem;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-main:hover {
        background: var(--confetti-green);
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(34, 197, 94, 0.2);
    }

    .btn-sub {
        background: #fff;
        color: var(--confetti-dark) !important;
        border: 1.5px solid var(--confetti-border);
        padding: 1rem 2.5rem;
        border-radius: 12px;
        font-weight: 700;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-sub:hover {
        border-color: var(--confetti-dark);
        background: #f8fafc;
        transform: translateY(-2px);
    }
</style>

<div class="confetti-page">
    <div class="success-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    </div>

    <h1 class="confetti-title">Confirmed.</h1>
    <p class="confetti-subtitle">Thank you for curating with us. Your order is being prepared with care and will be
        dispatched shortly.</p>

    <div class="order-details-card">
        <div class="detail-row">
            <span class="detail-label">Order Manifest</span>
            <span class="detail-value">#@Model.Id.ToString().Substring(0, 8).ToUpper()</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Settlement Amount</span>
            <span class="detail-value">@Model.Total.ToString("C")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Current Phase</span>
            <span class="detail-value" style="color: var(--accent-green)">@Model.Status</span>
        </div>
        @if (TempData["StoreType"] != null)
        {
            <div class="detail-row">
                <span class="detail-label">Store Type (Abstract Factory)</span>
                <span class="detail-value">@TempData["StoreType"]</span>
            </div>
        }
        @if (TempData["DeliveryInfo"] != null)
        {
            <div class="detail-row">
                <span class="detail-label">Delivery Method (Bridge Pattern)</span>
                <span class="detail-value">@TempData["DeliveryInfo"]</span>
            </div>
        }
    </div>

    <div class="btn-row">
        <a asp-controller="Home" asp-action="Index" class="btn-main">Continue Selection</a>
        <a asp-controller="Orders" asp-action="MyOrders" class="btn-sub">View History</a>
    </div>
</div>
